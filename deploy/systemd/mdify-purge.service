[Unit]
Description=Delete expired mdify documents
After=postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/mdify/app/backend
EnvironmentFile=/etc/mdify/backend.env
ExecStart=/opt/mdify/app/backend/.venv/bin/python manage.py purge_expired
ProtectHome=true
ReadWritePaths=/var/lib/mdify
